{
  "name": "lougger",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents read application logs from OpenSearch Dashboards and follow a trace across Kubernetes namespaces and apps",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opensearch",
    "logs",
    "tracing",
    "kubernetes"
  ],
  "author": "mbaracz",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lougger": "dist/cli.js"
  },
  "files": [
    "dist",
    "config.example.toml"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm test",
    "prepublishOnly": "pnpm run check && pnpm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "smol-toml": "^1.9.1",
    "undici": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.28.4"
}
